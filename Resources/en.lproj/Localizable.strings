/* Countdown, lower-case: the capital is added where the label is built.
   Abbreviated on purpose: a panel header has room for "in 12 min"
   and not for a spelled-out plural, and abbreviations decline in no language. */
"now" = "now";
"any moment" = "any moment";
"tomorrow" = "tomorrow";
"in %d min" = "in %d min";
"in %d h" = "in %d h";
"in %d h %d min" = "in %d h %d min";
"in %d d" = "in %d d";

/* Saved screenshots. The key is the date format itself, so a language can put
   the parts in its own order. */
"Screenshot" = "Screenshot";
"yyyy-MM-dd 'at' HH.mm.ss" = "yyyy-MM-dd 'at' HH.mm.ss";
